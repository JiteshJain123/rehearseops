# Copy this file to .env. Never commit real API keys.
# Get a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Two NVIDIA Nemotron tiers. Check the exact IDs in your catalog (Integrations → List Nemotron models).
# If an ID is not found, the server picks the closest Nemotron model from your catalog and shows that it did.
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_TIMEOUT_MS=90000

# Optional: Tavily documentation grounding inside the agent loop (Best Use of Tavily).
TAVILY_API_KEY=

# Protect credits on a public demo: max model-backed runs per hour (whole server).
MAX_MODEL_RUNS_PER_HOUR=60

PORT=4173
HOST=0.0.0.0
NODE_ENV=development
# Set TRUST_PROXY=1 only behind a reverse proxy that sanitizes X-Forwarded-For (e.g. Render).
TRUST_PROXY=0
